---
import CategoryCarousel from "../components/CategoryCarousel.astro";
import Hero from "../components/Hero.astro";
import PerfumeCard from "../components/PerfumeCard.astro";
import { PERFUMES } from "../data/perfumes";
import BaseLayout from "../layouts/BaseLayout.astro";

const highlightSlugs = [
  "sunset-in-paris",
  "wildfire",
  "black-blaze",
  "winter-fireworks",
  "london-city-lights",
  "deep-blue",
  "joshua-tree",
  "velvet-underground",
];
const highlights = highlightSlugs.map(
  (slug) => PERFUMES.find((p) => p.slug === slug)!,
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Àerre, rebuilt — a redesign concept">
  <Hero />

  <section class="categories-band" id="categories">
    <div class="categories">
      <h2>Shop by scent</h2>
      <CategoryCarousel />
    </div>
  </section>

  <section class="highlights">
    <div class="heading-row">
      <h2>Highlights</h2>
      <a href={`${base}perfumes/`} class="cta-pill">See all perfumes →</a>
    </div>
    <div class="grid">
      {highlights.map((perfume) => <PerfumeCard perfume={perfume} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .categories,
  .highlights {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-3);
  }

  .categories-band {
    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-bg));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  @media (max-width: 47.9375rem) {
    .categories {
      padding-top: var(--space-1);
      padding-bottom: var(--space-2);
    }
  }

  .categories h2,
  .highlights h2 {
    margin: 0 0 var(--space-2);
  }

  .heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .heading-row h2 {
    margin: 0;
  }

  .cta-pill {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-ink);
    text-decoration: none;
    font-size: 0.9rem;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .cta-pill:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .grid {
    margin-top: var(--space-2);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
</style>
