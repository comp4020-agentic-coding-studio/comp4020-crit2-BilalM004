---
import PerfumeCard from "../../components/PerfumeCard.astro";
import { PERFUMES, SCENT_FAMILIES, slugify, type ScentFamily } from "../../data/perfumes";
import BaseLayout from "../../layouts/BaseLayout.astro";

const families = Object.keys(SCENT_FAMILIES) as ScentFamily[];

const GENDERS = ["women", "men", "unisex"] as const;
const GENDER_LABEL: Record<(typeof GENDERS)[number], string> = {
  women: "Women",
  men: "Men",
  unisex: "Unisex",
};

const brands = [...new Set(PERFUMES.map((p) => p.inspiredBy.brand))].sort((a, b) =>
  a.localeCompare(b),
);

const notes = [
  ...new Set(PERFUMES.flatMap((p) => [...p.notes.top, ...p.notes.heart, ...p.notes.base])),
].sort((a, b) => a.localeCompare(b));

const SORT_OPTIONS = [
  { value: "featured", label: "Featured" },
  { value: "best-selling", label: "Best Selling" },
  { value: "price-asc", label: "Price: Low to High" },
  { value: "price-desc", label: "Price: High to Low" },
  { value: "alpha", label: "Alphabetical, A–Z" },
];
---

<BaseLayout title="All Perfumes — Àerre, rebuilt">
  <section class="intro">
    <h1>All Perfumes</h1>
    <p>
      Every fragrance in one place — filter by gender, scent family, the luxury brand it's
      inspired by, or a note, then sort however suits you.
    </p>
  </section>

  <section class="catalog">
    <form class="filters" aria-label="Filter and sort perfumes">
      <div class="control search-control">
        <label for="search">Search</label>
        <input
          type="search"
          id="search"
          name="search"
          placeholder="Perfume or brand…"
          autocomplete="off"
        />
      </div>

      <details class="control filter-menu">
        <summary>
          Filter
          <span class="badge" id="filter-count" hidden></span>
        </summary>
        <div class="panel">
          <fieldset data-filter="gender">
            <legend>Gender</legend>
            <div class="option-list">
              {
                GENDERS.map((g) => (
                  <label class="option">
                    <input type="checkbox" value={g} />
                    {GENDER_LABEL[g]}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset data-filter="family">
            <legend>Scent family</legend>
            <div class="option-list">
              {
                families.map((slug) => (
                  <label class="option">
                    <input type="checkbox" value={slug} />
                    {SCENT_FAMILIES[slug].name}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset data-filter="brand">
            <legend>Inspired by</legend>
            <div class="option-list">
              {
                brands.map((brand) => (
                  <label class="option">
                    <input type="checkbox" value={slugify(brand)} />
                    {brand}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <fieldset class="notes-fieldset" data-filter="notes">
            <legend>Notes</legend>
            <div class="option-list notes-list">
              {
                notes.map((note) => (
                  <label class="option">
                    <input type="checkbox" value={slugify(note)} />
                    {note}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="panel-actions">
            <button type="button" class="text-button clear-filters">Clear all</button>
            <button type="button" class="apply-filters">View results</button>
          </div>
        </div>
      </details>

      <details class="control sort-menu">
        <summary>Sort by: <span id="sort-label">Featured</span></summary>
        <ul class="sort-options">
          {
            SORT_OPTIONS.map((opt) => (
              <li>
                <button
                  type="button"
                  data-sort={opt.value}
                  aria-pressed={opt.value === "featured" ? "true" : "false"}
                >
                  {opt.label}
                </button>
              </li>
            ))
          }
        </ul>
      </details>
    </form>

    <p class="count" role="status"></p>

    <div class="grid">
      {PERFUMES.map((perfume) => <PerfumeCard perfume={perfume} />)}
    </div>
    <p class="empty" hidden>No perfumes match those filters — try clearing a few.</p>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>(".filters");
  const grid = document.querySelector<HTMLElement>(".grid");
  const cards = Array.from(grid?.querySelectorAll<HTMLElement>(".card") ?? []);
  const countEl = document.querySelector<HTMLElement>(".count");
  const emptyEl = document.querySelector<HTMLElement>(".empty");
  const searchInput = document.querySelector<HTMLInputElement>("#search");

  const filterMenu = document.querySelector<HTMLDetailsElement>(".filter-menu");
  const filterCountBadge = document.querySelector<HTMLElement>("#filter-count");

  const sortMenu = document.querySelector<HTMLDetailsElement>(".sort-menu");
  const sortLabel = document.querySelector<HTMLElement>("#sort-label");
  const sortButtons = Array.from(
    sortMenu?.querySelectorAll<HTMLButtonElement>("button[data-sort]") ?? [],
  );
  let currentSort = "featured";

  function checkedValues(filterName: string): string[] {
    return Array.from(
      form?.querySelectorAll<HTMLInputElement>(
        `[data-filter="${filterName}"] input[type="checkbox"]:checked`,
      ) ?? [],
    ).map((input) => input.value);
  }

  function matchesSearch(card: HTMLElement, query: string): boolean {
    if (!query) return true;
    const name = card.dataset.name?.toLowerCase() ?? "";
    const brand = (card.dataset.brand ?? "").replace(/-/g, " ");
    return name.includes(query) || brand.includes(query);
  }

  function matches(card: HTMLElement): boolean {
    const query = searchInput?.value.trim().toLowerCase() ?? "";
    if (!matchesSearch(card, query)) return false;

    const genders = checkedValues("gender");
    const cardGenders = card.dataset.genders?.split(" ") ?? [];
    if (genders.length && !genders.some((g) => cardGenders.includes(g))) return false;

    const families = checkedValues("family");
    if (families.length && !families.includes(card.dataset.family ?? "")) return false;

    const brands = checkedValues("brand");
    if (brands.length && !brands.includes(card.dataset.brand ?? "")) return false;

    const notes = checkedValues("notes");
    const cardNotes = card.dataset.notes?.split(" ") ?? [];
    if (notes.length && !notes.every((n) => cardNotes.includes(n))) return false;

    return true;
  }

  function sortValue(card: HTMLElement): number {
    switch (currentSort) {
      case "best-selling":
        return Number(card.dataset.popularity);
      case "price-asc":
        return Number(card.dataset.price);
      case "price-desc":
        return -Number(card.dataset.price);
      default:
        return cards.indexOf(card);
    }
  }

  function updateFilterCount() {
    const total = form?.querySelectorAll<HTMLInputElement>(
      '.filter-menu input[type="checkbox"]:checked',
    ).length ?? 0;
    if (!filterCountBadge) return;
    filterCountBadge.textContent = String(total);
    filterCountBadge.hidden = total === 0;
  }

  function apply() {
    const visible = cards.filter((card) => {
      const show = matches(card);
      card.style.display = show ? "" : "none";
      return show;
    });

    const ordered =
      currentSort === "alpha"
        ? [...visible].sort((a, b) => (a.dataset.name ?? "").localeCompare(b.dataset.name ?? ""))
        : [...visible].sort((a, b) => sortValue(a) - sortValue(b));

    ordered.forEach((card, i) => {
      card.style.order = String(i);
    });

    if (countEl)
      countEl.textContent = `${visible.length} perfume${visible.length === 1 ? "" : "s"}`;
    if (emptyEl) emptyEl.hidden = visible.length > 0;
    updateFilterCount();
  }

  form?.addEventListener("input", apply);
  form?.addEventListener("change", apply);

  document.querySelector(".clear-filters")?.addEventListener("click", () => {
    form
      ?.querySelectorAll<HTMLInputElement>('.filter-menu input[type="checkbox"]')
      .forEach((input) => (input.checked = false));
    apply();
  });

  document.querySelector(".apply-filters")?.addEventListener("click", () => {
    if (filterMenu) filterMenu.open = false;
  });

  sortButtons.forEach((button) => {
    button.addEventListener("click", () => {
      currentSort = button.dataset.sort ?? "featured";
      sortButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
      if (sortLabel) sortLabel.textContent = button.textContent?.trim() ?? "";
      if (sortMenu) sortMenu.open = false;
      apply();
    });
  });

  const params = new URLSearchParams(location.search);
  const genderParam = params.get("gender");
  const brandParam = params.get("brand");
  form
    ?.querySelectorAll<HTMLInputElement>('[data-filter="gender"] input[type="checkbox"]')
    .forEach((input) => {
      if (input.value === genderParam) input.checked = true;
    });
  form
    ?.querySelectorAll<HTMLInputElement>('[data-filter="brand"] input[type="checkbox"]')
    .forEach((input) => {
      if (input.value === brandParam) input.checked = true;
    });

  apply();
</script>

<style>
  .intro {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-3) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .intro p {
    max-width: 40rem;
    color: var(--color-muted);
  }

  .catalog {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 var(--space-3) var(--space-4);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    margin-bottom: var(--space-2);
  }

  .control {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: none;
    margin: 0;
    padding: 0;
  }

  .control > label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .search-control {
    flex: 1 1 13rem;
  }

  .search-control input {
    font: inherit;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    background: var(--color-bg);
    color: var(--color-ink);
  }

  .search-control input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  /* Filter + sort menus: a details/summary button that pops a positioned panel,
     matching the single "Filter" / single "Sort by" dropdown pattern on
     aerre.co, rather than a row of always-visible controls. */
  .filter-menu,
  .sort-menu {
    position: relative;
  }

  .filter-menu summary,
  .sort-menu summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 0.9rem;
    cursor: pointer;
    list-style: none;
  }

  .filter-menu summary::-webkit-details-marker,
  .sort-menu summary::-webkit-details-marker {
    display: none;
  }

  .filter-menu summary::after,
  .sort-menu summary::after {
    content: " ▾";
    color: var(--color-muted);
  }

  .filter-menu[open] summary,
  .sort-menu[open] summary {
    border-color: var(--color-accent);
  }

  .badge[hidden] {
    display: none;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-surface);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .panel {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 0;
    z-index: 20;
    width: min(90vw, 46rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 10%);
  }

  .panel fieldset {
    border: none;
    margin: 0;
    padding: 0;
    grid-column: span 1;
  }

  .notes-fieldset {
    grid-column: 1 / -1;
  }

  .panel legend {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0;
    margin-bottom: 0.5rem;
  }

  .panel-actions {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .text-button {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.85rem;
    text-decoration: underline;
    cursor: pointer;
  }

  .text-button:hover {
    color: var(--color-accent);
  }

  .apply-filters {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.35rem;
    background: var(--color-ink);
    color: var(--color-surface);
    cursor: pointer;
  }

  .sort-options {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 0;
    z-index: 20;
    min-width: 14rem;
    margin: 0;
    padding: var(--space-1) 0;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 10%);
  }

  .sort-options button {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.5rem var(--space-2);
    border: none;
    background: none;
    font: inherit;
    font-size: 0.85rem;
    color: var(--color-ink);
    cursor: pointer;
  }

  .sort-options button:hover {
    background: var(--color-bg);
  }

  .sort-options button[aria-pressed="true"] {
    color: var(--color-accent);
    font-weight: 700;
  }

  .option-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .option {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--color-ink);
    white-space: nowrap;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .option:hover {
    border-color: var(--color-accent);
  }

  .option:has(input:checked) {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-bg));
  }

  .option input {
    accent-color: var(--color-accent);
  }

  .notes-list {
    max-height: 6.5rem;
    overflow-y: auto;
    padding: 0.15rem 0.4rem 0.15rem 0;
  }

  .count {
    margin: 0 0 var(--space-2);
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }

  .empty {
    color: var(--color-muted);
    padding: var(--space-4) 0;
    text-align: center;
  }

  @media (max-width: 47.9375rem) {
    .filters {
      flex-direction: column;
    }

    .control,
    .search-control {
      flex: 0 0 auto;
      min-width: 0;
      width: 100%;
    }

    .filter-menu summary,
    .sort-menu summary {
      width: 100%;
      justify-content: space-between;
    }

    .panel,
    .sort-options {
      position: static;
      width: 100%;
      grid-template-columns: 1fr;
      margin-top: var(--space-1);
    }
  }
</style>
