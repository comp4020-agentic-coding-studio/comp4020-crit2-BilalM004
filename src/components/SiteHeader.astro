---
import { PERFUMES, SCENT_FAMILIES, slugify } from "../data/perfumes";

const base = import.meta.env.BASE_URL;
const families = Object.entries(SCENT_FAMILIES);
const genders = [
  { slug: "women", name: "Women" },
  { slug: "men", name: "Men" },
  { slug: "unisex", name: "Unisex" },
];
const brands = [...new Set(PERFUMES.map((p) => p.inspiredBy.brand))].sort((a, b) =>
  a.localeCompare(b),
);
---

<header class="site-header">
  <div class="row">
    <a class="wordmark" href={base}>
      <span class="mark">Àerre</span>
      <span class="tag">(rebuilt)</span>
    </a>
    <nav aria-label="Primary">
      <a href={base}>Home</a>
      <a href={`${base}perfumes/`}>All Perfumes</a>
      <details class="categories">
        <summary>Scent</summary>
        <ul>
          {
            families.map(([slug, info]) => (
              <li>
                <a href={`${base}perfumes/${slug}/`}>{info.name}</a>
              </li>
            ))
          }
        </ul>
      </details>
      <details class="categories">
        <summary>Gender</summary>
        <ul>
          {
            genders.map(({ slug, name }) => (
              <li>
                <a href={`${base}perfumes/?gender=${slug}`}>{name}</a>
              </li>
            ))
          }
        </ul>
      </details>
      <details class="categories">
        <summary>Inspired By</summary>
        <ul>
          {
            brands.map((brand) => (
              <li>
                <a href={`${base}perfumes/?brand=${slugify(brand)}`}>{brand}</a>
              </li>
            ))
          }
        </ul>
      </details>
      <a href="https://aerre.co/" target="_blank" rel="noopener noreferrer" class="source-link">
        See the real Àerre store ↗
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .row {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-2) var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark .mark {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-accent);
  }

  .wordmark .tag {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    font-size: 0.9rem;
  }

  nav a {
    color: var(--color-ink);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-accent);
  }

  .source-link {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .categories {
    position: relative;
  }

  .categories summary {
    cursor: pointer;
    color: var(--color-ink);
    list-style: none;
  }

  .categories summary::-webkit-details-marker {
    display: none;
  }

  .categories summary::after {
    content: " ▾";
    color: var(--color-muted);
  }

  .categories[open] summary::after {
    content: " ▴";
  }

  .categories ul {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 0;
    margin: 0;
    padding: var(--space-1) 0;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    box-shadow: 0 0.25rem 0.75rem rgb(0 0 0 / 8%);
    min-width: 12rem;
    z-index: 10;
  }

  .categories li a {
    display: block;
    padding: var(--space-1) var(--space-2);
    white-space: nowrap;
  }

  .categories li a:hover {
    background: var(--color-bg);
  }
</style>
