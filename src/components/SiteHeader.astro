---
import { SCENT_FAMILIES } from "../data/perfumes";

const base = import.meta.env.BASE_URL;
const families = Object.entries(SCENT_FAMILIES);
---

<header class="site-header">
  <div class="row">
    <a class="wordmark" href={base}>Àerre, rebuilt</a>
    <nav aria-label="Primary">
      <a href={base}>Home</a>
      <a href={`${base}perfumes/`}>All Perfumes</a>
      <details class="categories">
        <summary>Categories</summary>
        <ul>
          {
            families.map(([slug, info]) => (
              <li>
                <a href={`${base}perfumes/${slug}/`}>{info.name}</a>
              </li>
            ))
          }
        </ul>
      </details>
      <a href="https://aerre.co/" target="_blank" rel="noopener noreferrer" class="source-link">
        See the real Àerre store ↗
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .row {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-2) var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    font-size: 0.9rem;
  }

  nav a {
    color: var(--color-ink);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-accent);
  }

  .source-link {
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .categories {
    position: relative;
  }

  .categories summary {
    cursor: pointer;
    color: var(--color-ink);
    list-style: none;
  }

  .categories summary::-webkit-details-marker {
    display: none;
  }

  .categories summary::after {
    content: " ▾";
    color: var(--color-muted);
  }

  .categories[open] summary::after {
    content: " ▴";
  }

  .categories ul {
    position: absolute;
    top: calc(100% + var(--space-1));
    left: 0;
    margin: 0;
    padding: var(--space-1) 0;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    box-shadow: 0 0.25rem 0.75rem rgb(0 0 0 / 8%);
    min-width: 12rem;
    z-index: 10;
  }

  .categories li a {
    display: block;
    padding: var(--space-1) var(--space-2);
    white-space: nowrap;
  }

  .categories li a:hover {
    background: var(--color-bg);
  }
</style>
