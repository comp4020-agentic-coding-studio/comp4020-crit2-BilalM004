---
import { Image } from "astro:assets";

import { SCENT_FAMILIES, slugify, type Perfume } from "../data/perfumes";

interface Props {
  perfume: Perfume;
}

const { perfume } = Astro.props;
const genderLabel = perfume.genders
  .map((g) => (g === "unisex" ? "Unisex" : g === "women" ? "Women" : "Men"))
  .join(" / ");
const allNotes = [...perfume.notes.top, ...perfume.notes.heart, ...perfume.notes.base];
---

<article
  class="card"
  data-name={perfume.name}
  data-family={perfume.family}
  data-genders={perfume.genders.join(" ")}
  data-brand={slugify(perfume.inspiredBy.brand)}
  data-notes={allNotes.map(slugify).join(" ")}
  data-price={perfume.price}
  data-popularity={perfume.popularity}
>
  <a class="thumb" href={perfume.sourceUrl} target="_blank" rel="noopener noreferrer">
    <Image src={perfume.image.src} alt={perfume.image.alt} width={400} height={400} />
  </a>
  <div class="body">
    <div class="badges">
      <span class={`badge family-${perfume.family}`}>{SCENT_FAMILIES[perfume.family].name}</span>
      <span class={`badge gender-${perfume.genders[0]}`}>{genderLabel}</span>
    </div>
    <h3>{perfume.name}</h3>
    <p class="inspired">Inspired by {perfume.inspiredBy.brand} {perfume.inspiredBy.item}</p>
    <p class="notes">{perfume.notes.heart.join(", ")}</p>
    <div class="footer-row">
      <span class="price">${perfume.price}</span>
      <a class="view-link" href={perfume.sourceUrl} target="_blank" rel="noopener noreferrer">
        View on Àerre →
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .thumb {
    display: block;
    aspect-ratio: 1;
    background: var(--color-bg);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .badges {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    color: var(--color-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .family-citrus-fresh {
    color: #14707a;
    background: #e3f2f4;
    border-color: #cbe6e9;
  }

  .family-floral {
    color: #a6295f;
    background: #fbe4ee;
    border-color: #f4cddf;
  }

  .family-woody {
    color: #55642f;
    background: #eef1e1;
    border-color: #dde3c9;
  }

  .family-amber-spice {
    color: #96581a;
    background: #fbead4;
    border-color: #f3d9b0;
  }

  .family-gourmand {
    color: #6b5344;
    background: #efe6e0;
    border-color: #ddccc0;
  }

  .gender-women {
    color: #c15a83;
    background: #fdeaf0;
    border-color: #f8d6e2;
  }

  .gender-men {
    color: #4c74b8;
    background: #e9f0fc;
    border-color: #cfe0f7;
  }

  .gender-unisex {
    color: #6f5a95;
    background: #efeaf6;
    border-color: #ddd3ee;
  }

  h3 {
    margin: 0;
    font-size: 1.1rem;
    color: var(--color-name);
  }

  .inspired {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-inspired);
  }

  .notes {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-ink);
  }

  .footer-row {
    margin-top: var(--space-1);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .price {
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }

  .view-link {
    font-size: 0.85rem;
    white-space: nowrap;
  }
</style>
