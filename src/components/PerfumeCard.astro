---
import { Image } from "astro:assets";

import { SCENT_FAMILIES, type Perfume } from "../data/perfumes";

interface Props {
  perfume: Perfume;
}

const { perfume } = Astro.props;
const genderLabel = perfume.genders
  .map((g) => (g === "unisex" ? "Unisex" : g === "women" ? "Women" : "Men"))
  .join(" / ");
---

<article class="card">
  <a class="thumb" href={perfume.sourceUrl} target="_blank" rel="noopener noreferrer">
    <Image src={perfume.image.src} alt={perfume.image.alt} width={400} height={400} />
  </a>
  <div class="body">
    <div class="badges">
      <span class="badge family">{SCENT_FAMILIES[perfume.family].name}</span>
      <span class="badge gender">{genderLabel}</span>
    </div>
    <h3>{perfume.name}</h3>
    <p class="inspired">Inspired by {perfume.inspiredBy.brand} {perfume.inspiredBy.item}</p>
    <p class="notes">{perfume.notes.heart.join(", ")}</p>
    <div class="footer-row">
      <span class="price">${perfume.price}</span>
      <a class="view-link" href={perfume.sourceUrl} target="_blank" rel="noopener noreferrer">
        View on Àerre →
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .thumb {
    display: block;
    aspect-ratio: 1;
    background: var(--color-bg);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .badges {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    color: var(--color-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .inspired {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .notes {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-ink);
  }

  .footer-row {
    margin-top: var(--space-1);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .price {
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }

  .view-link {
    font-size: 0.85rem;
    white-space: nowrap;
  }
</style>
