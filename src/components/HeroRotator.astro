---
import { Image } from "astro:assets";

import { PERFUMES, SCENT_FAMILIES } from "../data/perfumes";
import { CRUELTY_FREE, PRESS_MENTIONS, PRESS_STYLES, STATS } from "../data/testimonials";

const featured = PERFUMES.find((p) => p.slug === "bliss-release")!;

const slides = [
  { type: "motion" as const, label: "Featured product" },
  { type: "cruelty-free" as const, label: "Vegan & cruelty free" },
  { type: "stats" as const, label: "Our numbers" },
  { type: "press" as const, label: "Press" },
];
---

<div class="hero-rotator">
  <div class="viewport" role="region" aria-label="Reviews, press and product highlights" aria-live="polite">
    {
      slides.map((slide, i) => (
        <div
          class={`slide slide--${slide.type}`}
          data-slide={i}
          data-type={slide.type}
          data-active={i === 0 ? "true" : undefined}
        >
          {slide.type === "cruelty-free" && (
            <>
              <p class="cruelty-headline">{CRUELTY_FREE.headline}</p>
              <p class="cruelty-claim">{CRUELTY_FREE.claim}</p>
              <span class="slide-label">Vegan &amp; cruelty free</span>
            </>
          )}
          {slide.type === "stats" && (
            <ul class="stats">
              {STATS.map((stat) => <li>{stat}</li>)}
            </ul>
          )}
          {slide.type === "press" && (
            <>
              <span class="press-heading">As seen in</span>
              <ul class="press">
                {PRESS_MENTIONS.map((name, j) => <li class={`press-logo press-logo--${PRESS_STYLES[j]}`}>{name}</li>)}
              </ul>
            </>
          )}
          {slide.type === "motion" && (
            <a class="motion" href={featured.sourceUrl} target="_blank" rel="noopener noreferrer">
              <Image src={featured.image.src} alt={featured.image.alt} width={480} height={480} />
              <span class="caption">
                <span class="name">{featured.name}</span>
                <span class="meta">{SCENT_FAMILIES[featured.family].name} · ${featured.price}</span>
              </span>
            </a>
          )}
        </div>
      ))
    }
  </div>

  <div class="controls">
    <button type="button" class="arrow prev" aria-label="Previous slide" data-dir="-1">‹</button>
    <div class="dots" role="tablist" aria-label="Choose slide">
      {
        slides.map((slide, i) => (
          <button
            type="button"
            class="dot"
            data-goto={i}
            aria-current={i === 0 ? "true" : "false"}
            aria-label={slide.label}
          />
        ))
      }
    </div>
    <button type="button" class="arrow next" aria-label="Next slide" data-dir="1">›</button>
  </div>
</div>

<script>
  const rotator = document.querySelector<HTMLElement>(".hero-rotator");
  const viewport = rotator?.querySelector<HTMLElement>(".viewport");
  const slides = Array.from(rotator?.querySelectorAll<HTMLElement>(".slide") ?? []);
  const dots = Array.from(rotator?.querySelectorAll<HTMLButtonElement>(".dot") ?? []);
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const controller = new AbortController();
  const { signal } = controller;

  function show(index: number) {
    const target = ((index % slides.length) + slides.length) % slides.length;
    slides.forEach((slide, i) => {
      if (i === target) slide.setAttribute("data-active", "true");
      else slide.removeAttribute("data-active");
    });
    dots.forEach((dot, i) => {
      dot.setAttribute("aria-current", String(i === target));
    });
    viewport?.setAttribute("data-tint", slides[target].dataset.type ?? "");
  }

  function current() {
    return slides.findIndex((slide) => slide.hasAttribute("data-active"));
  }

  rotator?.querySelectorAll<HTMLButtonElement>(".arrow").forEach((button) => {
    button.addEventListener(
      "click",
      () => {
        show(current() + Number(button.dataset.dir));
        restart();
      },
      { signal },
    );
  });

  dots.forEach((dot) => {
    dot.addEventListener(
      "click",
      () => {
        show(Number(dot.dataset.goto));
        restart();
      },
      { signal },
    );
  });

  let timer: number | undefined;

  function start() {
    if (reduceMotion) return;
    timer = window.setInterval(() => show(current() + 1), 3000);
  }

  function stop() {
    window.clearInterval(timer);
  }

  function restart() {
    stop();
    start();
  }

  rotator?.addEventListener("mouseenter", stop, { signal });
  rotator?.addEventListener("mouseleave", start, { signal });
  rotator?.addEventListener("focusin", stop, { signal });
  rotator?.addEventListener("focusout", start, { signal });

  start();

  if (import.meta.hot) {
    import.meta.hot.dispose(() => {
      stop();
      controller.abort();
    });
  }
</script>

<style>
  .hero-rotator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .viewport {
    position: relative;
    width: min(100%, 22rem);
    aspect-ratio: 1;
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 2rem 3rem -2rem rgba(20, 15, 10, 0.28);
  }

  @media (max-width: 47.9375rem) {
    .viewport {
      width: min(60%, 10rem);
    }
  }

  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 2s ease-in;
  }

  .slide[data-active="true"] {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .slide {
      transform: scale(0.94);
      transition: opacity 2s ease-in, transform 2s ease-in;
    }

    .slide[data-active="true"] {
      transform: scale(1);
    }
  }

  .viewport::before {
    content: "";
    position: absolute;
    inset: 0;
    background-size: 180% 180%;
    background-position: 30% 20%;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .viewport::before {
      animation: drift 9s ease-in-out infinite alternate;
    }
  }

  @keyframes drift {
    from {
      background-position: 20% 10%;
    }

    to {
      background-position: 80% 90%;
    }
  }

  .viewport[data-tint="cruelty-free"]::before {
    opacity: 1;
    background-image: radial-gradient(120% 120% at 50% 0%, color-mix(in srgb, var(--color-accent) 28%, transparent), transparent 60%);
  }

  .viewport[data-tint="stats"]::before {
    opacity: 1;
    background-image: radial-gradient(120% 120% at 50% 100%, color-mix(in srgb, var(--color-name) 28%, transparent), transparent 60%);
  }

  .viewport[data-tint="press"]::before {
    opacity: 1;
    background-image: radial-gradient(120% 120% at 0% 50%, color-mix(in srgb, var(--color-inspired) 24%, transparent), transparent 65%);
  }

  .cruelty-headline {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    line-height: 1.3;
  }

  .cruelty-claim {
    margin: var(--space-2) 0 0;
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.4;
  }

  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    text-align: center;
  }

  .slide-label {
    margin-top: var(--space-2);
    font-size: 0.8rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .press-heading {
    font-size: 0.8rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .press {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: 1.15rem;
    color: var(--color-ink);
  }

  .press-logo--news {
    font-family: var(--font-sans);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .press-logo--weekly {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
  }

  .press-logo--who {
    font-family: var(--font-sans);
    font-weight: 800;
    font-style: italic;
    text-transform: uppercase;
  }

  .press-logo--marie-claire {
    font-family: var(--font-serif);
    text-transform: lowercase;
    letter-spacing: 0.03em;
  }

  .press-logo--mamamia {
    font-family: var(--font-sans);
    font-weight: 700;
  }

  .press-logo--bazaar {
    font-family: var(--font-serif);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  .motion {
    display: block;
    text-decoration: none;
    color: inherit;
    width: 100%;
    height: 100%;
  }

  .motion img {
    width: 100%;
    height: 72%;
    border-radius: 0.5rem;
    object-fit: cover;
    animation: ken-burns 12s ease-in-out infinite alternate;
  }

  @keyframes ken-burns {
    from {
      transform: scale(1) translate(0, 0);
    }

    to {
      transform: scale(1.12) translate(-1%, -1%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .motion img {
      animation: none;
    }
  }

  .caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    margin-top: var(--space-2);
    text-align: center;
  }

  .caption .name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.2;
    color: var(--color-name);
    letter-spacing: 0.01em;
  }

  .caption .meta {
    font-size: 0.75rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @media (max-width: 47.9375rem) {
    .slide {
      padding: var(--space-2);
    }

    .motion img {
      height: 62%;
    }

    .caption {
      gap: 0.1rem;
      margin-top: 0.3rem;
    }

    .caption .name {
      font-size: 0.85rem;
    }

    .caption .meta {
      font-size: 0.55rem;
      letter-spacing: 0.04em;
    }

    .press-heading {
      font-size: 0.55rem;
      margin-bottom: 0.3rem;
    }

    .press {
      gap: 0.15rem;
      font-size: 0.6rem;
    }
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .arrow {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-ink);
  }

  .arrow:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .dots {
    display: flex;
    gap: 0.5rem;
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 0;
    cursor: pointer;
  }

  .dot[aria-current="true"] {
    background: var(--color-ink);
    border-color: var(--color-ink);
  }
</style>
