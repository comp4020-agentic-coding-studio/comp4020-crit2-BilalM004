---
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="row">
    <ul class="facts">
      <li>Formulated and manufactured in France</li>
      <li>Vegan and cruelty-free</li>
      <li>30-day returns if a scent isn't right</li>
    </ul>

    <div class="about">
      <h2>About this redesign</h2>
      <p>
        This is a student redesign concept for <a href="https://aerre.co/" target="_blank" rel="noopener noreferrer">Àerre</a>, a real fragrance store, built as a non-commercial course exercise. It uses Àerre's real products, prices and fragrance notes, restructured around browsing by scent rather than by discount. It isn't a real store — visit <a href="https://aerre.co/" target="_blank" rel="noopener noreferrer">aerre.co</a> to actually buy something.
      </p>
      <a href={base}>Back to home</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    margin-top: var(--space-5);
  }

  .row {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-3);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 1fr 2fr;
    }
  }

  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .about h2 {
    font-size: 1.1rem;
    margin: 0 0 var(--space-1);
  }

  .about p {
    color: var(--color-muted);
    max-width: 40rem;
  }
</style>
