---
import HeroRotator from "./HeroRotator.astro";
import ReviewsBar from "./ReviewsBar.astro";

const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="copy">
    <p class="kicker">Stop overpaying for luxury fragrance</p>
    <h1>Australia's best, long-lasting, designer-quality perfumes.</h1>
    <div class="cta-row">
      <a class="cta primary" href={`${base}perfumes/`}>See all perfumes</a>
      <a class="cta secondary" href="#categories">Shop by scent</a>
    </div>
    <ReviewsBar />
  </div>
  <HeroRotator />
</section>

<style>
  .hero {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-3);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (max-width: 47.9375rem) {
    .hero {
      padding: var(--space-1) var(--space-3);
      gap: var(--space-1);
    }
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1fr 1fr;
    }
  }

  .copy p {
    color: var(--color-muted);
    max-width: 32rem;
  }

  .kicker {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  h1 {
    margin: 0.35rem 0 0;
    font-size: clamp(1.25rem, 2.6vw + 0.9rem, 2.2rem);
    line-height: 1.15;
  }

  @media (max-width: 47.9375rem) {
    .kicker {
      font-size: 0.65rem;
    }

    h1 {
      font-size: 1rem;
      line-height: 1.25;
      margin-top: 0.2rem;
    }
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .copy > :global(.reviews-bar) {
    margin-top: var(--space-3);
  }

  @media (max-width: 47.9375rem) {
    .copy > :global(.reviews-bar) {
      margin-top: var(--space-1);
    }
  }

  .cta {
    display: inline-block;
    padding: 0.6rem 1.25rem;
    border-radius: 0.25rem;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .cta.primary {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .cta.secondary {
    border: 1px solid var(--color-border);
    color: var(--color-ink);
  }
</style>
