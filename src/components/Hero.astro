---
import { Image } from "astro:assets";

import { PERFUMES, SCENT_FAMILIES } from "../data/perfumes";

const base = import.meta.env.BASE_URL;
const featured = PERFUMES.find((p) => p.slug === "bliss-release")!;
---

<section class="hero">
  <div class="copy">
    <h1>Àerre, rebuilt</h1>
    <p>
      Real Àerre fragrances, real notes, real prices — organised by scent
      instead of by discount. No popup, no subscription pitch: just the
      products.
    </p>
    <div class="cta-row">
      <a class="cta primary" href={`${base}perfumes/`}>See all perfumes</a>
      <a class="cta secondary" href="#categories">Shop by scent</a>
    </div>
  </div>
  <a class="art" href={featured.sourceUrl} target="_blank" rel="noopener noreferrer">
    <Image src={featured.image.src} alt={featured.image.alt} width={480} height={480} />
    <span class="caption">
      {featured.name} — {SCENT_FAMILIES[featured.family].name}, ${featured.price}
    </span>
  </a>
</section>

<style>
  .hero {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-3);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 1fr 1fr;
    }
  }

  .copy p {
    color: var(--color-muted);
    max-width: 32rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .cta {
    display: inline-block;
    padding: 0.6rem 1.25rem;
    border-radius: 0.25rem;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .cta.primary {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .cta.secondary {
    border: 1px solid var(--color-border);
    color: var(--color-ink);
  }

  .art {
    display: block;
    text-decoration: none;
    color: inherit;
    max-width: 22rem;
    margin: 0 auto;
  }

  .art img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 0.5rem;
  }

  .caption {
    display: block;
    margin-top: var(--space-1);
    font-size: 0.85rem;
    color: var(--color-muted);
    text-align: center;
  }
</style>
